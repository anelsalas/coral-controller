# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Coral Controller - declarative system setup.
# Apply:   winget configure -f setup\configuration.winget --accept-configuration-agreements
# Remove:  scripts\cleanup.ps1
# Only system-wide tools live here; all libraries come from vcpkg inside the project.
# CMake and Ninja are taken from the VS Build Tools "C++ CMake tools" component
# (no separate system-wide CMake/Ninja install).
# Arm GNU toolchain (firmware): deliberately NOT a winget package. winget only offers
# Arm.ArmGnuToolchain 12.x, but coralmicro pins gcc-arm-none-eabi-9-2020-q2-update. The SDK's
# CMake toolchain file downloads Arm's official win32 zip into the project on first configure:
#   third_party\coralmicro\third_party\toolchain-win  (no system install, removed by cleanup.ps1)
properties:
  configurationVersion: 0.2.0
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: git
      directives:
        description: Git for Windows (ARM64)
        allowPrerelease: false
      settings:
        id: Git.Git
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vsbuildtools
      directives:
        description: Visual Studio 2022 Build Tools
      settings:
        id: Microsoft.VisualStudio.2022.BuildTools
        source: winget
    - resource: Microsoft.VisualStudio.DSC/VSComponents
      id: vscomponents
      dependsOn:
        - vsbuildtools
      directives:
        description: C++ ARM64 toolchain, Windows SDK, CMake + Ninja
        allowPrerelease: true
      settings:
        productId: Microsoft.VisualStudio.Product.BuildTools
        channelId: VisualStudio.17.Release
        includeRecommended: false
        components:
          - Microsoft.VisualStudio.Workload.VCTools
          - Microsoft.VisualStudio.Component.VC.Tools.ARM64
          - Microsoft.VisualStudio.Component.VC.Tools.x86.x64
          - Microsoft.VisualStudio.Component.VC.CMake.Project
          - Microsoft.VisualStudio.Component.Windows11SDK.22621
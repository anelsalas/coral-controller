{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Coral Controller (app)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Unit tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/arm64-debug/tests/coral_unit_tests.exe",
      "args": ["--gtest_break_on_failure"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Integration tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/arm64-debug/tests/coral_integration_tests.exe",
      "args": ["--gtest_break_on_failure"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Hardware tests (board connected)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/arm64-debug/tests/coral_hardware_tests.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}